# Copy this file to .env for local development. On Netlify, add the same two names under Site configuration > Environment variables.
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon / public" key. Safe in the browser because row level security protects the data. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=
